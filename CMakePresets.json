{
  "version": 4,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },

  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "description": "Yang sama di semua platform. Compiler ikut di sini, bukan di turunannya: yang dipakai di Windows adalah clang++ yang sama, hanya saja menargetkan ABI MSVC — jadi flag peringatan di SimTargets.cmake berlaku apa adanya, sedangkan cl.exe tidak mengerti satu pun di antaranya.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "SIM_BUILD_TESTS": "ON",
        "SIM_BUILD_EDITOR": "ON",
        "SIM_WITH_LUA": "ON"
      }
    },
    {
      "name": "linux-base",
      "hidden": true,
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    },
    {
      "name": "windows-base",
      "hidden": true,
      "inherits": "base",
      "description": "Dijalankan dari Developer PowerShell for VS 2022 dengan -Arch amd64. Lingkungan itu yang menyediakan header dan LIB MSVC yang dipakai clang, plus cmake dan ninja bundel VS. Tanpanya konfigurasi gagal saat menguji compiler, dan -Arch bawaan (x86) gagal jauh lebih belakangan — di tautan.",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },

    {
      "name": "linux-clang-debug",
      "displayName": "Linux Clang Debug",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SIM_WERROR": "ON"
      }
    },
    {
      "name": "linux-clang-release",
      "displayName": "Linux Clang RelWithDebInfo",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "SIM_WERROR": "ON"
      }
    },
    {
      "name": "linux-clang-asan",
      "displayName": "Linux Clang ASan+UBSan",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer",
        "CMAKE_C_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined",
        "CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=address,undefined",
        "CMAKE_MODULE_LINKER_FLAGS": "-fsanitize=address,undefined",
        "SIM_SDL_SHARED": "OFF"
      }
    },
    {
      "name": "linux-clang-tsan",
      "displayName": "Linux Clang ThreadSanitizer",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-fsanitize=thread -fno-omit-frame-pointer",
        "CMAKE_C_FLAGS": "-fsanitize=thread -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=thread",
        "CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=thread",
        "CMAKE_MODULE_LINKER_FLAGS": "-fsanitize=thread",
        "SIM_SDL_SHARED": "OFF"
      }
    },

    {
      "name": "windows-clang-debug",
      "displayName": "Windows Clang Debug",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SIM_WERROR": "ON"
      }
    },
    {
      "name": "windows-clang-release",
      "displayName": "Windows Clang RelWithDebInfo",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "SIM_WERROR": "ON"
      }
    }
  ],

  "buildPresets": [
    { "name": "linux-clang-debug",   "configurePreset": "linux-clang-debug" },
    { "name": "linux-clang-release", "configurePreset": "linux-clang-release" },
    { "name": "linux-clang-asan",    "configurePreset": "linux-clang-asan" },
    { "name": "linux-clang-tsan",    "configurePreset": "linux-clang-tsan" },
    { "name": "windows-clang-debug",   "configurePreset": "windows-clang-debug" },
    { "name": "windows-clang-release", "configurePreset": "windows-clang-release" }
  ],

  "testPresets": [
    {
      "name": "linux-clang-debug",
      "configurePreset": "linux-clang-debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "linux-clang-asan",
      "configurePreset": "linux-clang-asan",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "windows-clang-debug",
      "configurePreset": "windows-clang-debug",
      "output": { "outputOnFailure": true }
    }
  ]
}
